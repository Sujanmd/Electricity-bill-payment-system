<%- include('header', { title: 'Sign Up' , user: null }) %>

    <div class="form-container">
        <h2 class="text-center" style="margin-bottom: 2rem;">Create Account</h2>

        <form action="/signup" method="POST">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="Enter your full name"
                    required>
            </div>

            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email"
                    required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" class="form-control"
                    placeholder="Create a password" required>
            </div>

            <!-- Hidden role field, default to user -->
            <input type="hidden" name="role" value="user">

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Sign Up</button>
        </form>

        <div class="text-center mt-4">
            <p style="color: var(--text-muted);">Already have an account? <a href="/login"
                    style="color: var(--primary);">Login</a></p>
        </div>
    </div>

    <%- include('footer') %>